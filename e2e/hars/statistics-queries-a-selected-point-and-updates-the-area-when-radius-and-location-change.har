ten: Murerkarte (1566) - Gygerkarte (1667) - Dufourkarte (1845) - Historische Wildkarte (1850) - Siegfriedkarte (1880) - Siegfriedkarte (1930) - Dufourkarte (1939) - Alte Landeskarte (1956). Die Karten wurden für den GIS-Browser gedreht und entzerrt. Dazu wurden gut 350 Punkte auf der jeweiligen Karte den heutigen Koordinaten zugewiesen.\",\"timesliderConfiguration\":{\"name\":\"Jahr\",\"range\":\"P1Y\",\"source\":{\"layers\":[{\"date\":\"1566\",\"layerName\":\"murerkarte_1566\"},{\"date\":\"1667\",\"layerName\":\"gygerkarte_1667\"},{\"date\":\"1845\",\"layerName\":\"dufour-erst\"},{\"date\":\"1850\",\"layerName\":\"wild\"},{\"date\":\"1880\",\"layerName\":\"sf1880\"},{\"date\":\"1930\",\"layerName\":\"sf1930\"},{\"date\":\"1939\",\"layerName\":\"dufour-letzt\"},{\"date\":\"1956\",\"layerName\":\"lk25_1956\"}]},\"dateFormat\":\"YYYY\",\"sourceType\":\"layer\",\"description\":\"Gewählte Zeitspanne\",\"maximumDate\":\"1956\",\"minimumDate\":\"1566\",\"alwaysMaxRange\":false},\"filterConfigurations\":null,\"searchConfigurations\":null,\"wms_url\":\"https://maps.zh.ch/wms/OrthoRGBZHhist\",\"gb2_url\":null,\"opacity\":1,\"layers\":[{\"id\":279212,\"geolion_gds\":494,\"geolion_geodatensatz_uuid\":\"12ef5217-4698-4e5a-b067-8248d059c567\",\"layer\":\"murerkarte_1566\",\"group_title\":null,\"title\":\"Historische Karte Jos Murer (1566)\",\"min_scale\":400,\"max_scale\":1500000,\"wms_sort\":0,\"toc_sort\":0,\"initially_visible\":true,\"queryable\":false},{\"id\":279213,\"geolion_gds\":488,\"geolion_geodatensatz_uuid\":\"5eff9fbd-47e0-4f84-be28-536b974d7835\",\"layer\":\"gygerkarte_1667\",\"group_title\":null,\"title\":\"Historische Karte Hans Conrad Gyger (1667)d\",\"min_scale\":400,\"max_scale\":1500000,\"wms_sort\":1,\"toc_sort\":100,\"initially_visible\":true,\"queryable\":false},{\"id\":279214,\"geolion_gds\":114,\"geolion_geodatensatz_uuid\":\"ddfe2f7a-1d9f-4944-a30b-812e0e597d6f\",\"layer\":\"dufour-erst\",\"group_title\":null,\"title\":\"Dufourkarte Erstausgabe 1845-65