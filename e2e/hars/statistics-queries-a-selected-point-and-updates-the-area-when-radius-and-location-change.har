":null,\"geolion_karten_uuid\":\"896fa149-b815-4d71-9de8-969e45c416ca\",\"keywords\":[\"Hinweiskarte\",\"anthropogene\",\"Böden\",\"boden\",\"TBAK2\",\"fsla\",\"fabo\"],\"notice\":\"In der Karte ausgewiesene Flächen, auf denen die Schaffung neuer FFF i.d.R. möglich ist, erfüllen aufgrund des aktuellen Datenstandes folgende Bedingungen: Es sind Hinweise auf anthropogene Böden vorhanden, es sind keine oder nur bedingt geeignete FFF vorhanden und es sind keine Einschränkungen bekannt, die der Neuschaffung oder Verbesserung von FFF entgegenstehen. Die tatsächliche Eignung einer Fläche für die Neuschaffung von FFF muss im Einzelfall geprüft werden.\",\"timesliderConfiguration\":null,\"filterConfigurations\":null,\"searchConfigurations\":null,\"wms_url\":\"https://maps.zh.ch/wms/FaboAnthroposolZH\",\"gb2_url\":null,\"opacity\":1,\"layers\":[{\"id\":270748,\"geolion_gds\":92,\"geolion_geodatensatz_uuid\":\"ac87d334-7579-ca8c-8466-0cd3226bfa49\",\"layer\":\"landwirtschaftliche-nutzungseignung\",\"group_title\":null,\"title\":\"Landw. Nutzungseignungsklassen (nur Abfrage)\",\"min_scale\":1,\"max_scale\":25000,\"wms_sort\":2,\"toc_sort\":200,\"initially_visible\":true,\"queryable\":true},{\"id\":270749,\"geolion_gds\":null,\"geolion_geodatensatz_uuid\":null,\"layer\":\"einschraenkungsflaechen_fff\",\"group_title\":null,\"title\":\"Einschränkung für FFF-Schaffung (nur Abfrage)\",\"min_scale\":1,\"max_scale\":25000,\"wms_sort\":3,\"toc_sort\":300,\"initially_visible\":true,\"queryable\":true},{\"id\":270750,\"geolion_gds\":2,\"geolion_geodatensatz_uuid\":\"0aa893ad-c264-ce46-bf1f-6fa785998b8c\",\"layer\":\"fruchtfolgeflaechen-fff\",\"group_title\":null,\"title\":\"Fruchtfolgeflächen (FFF)\",\"min_scale\":1,\"max_scale\":25000,\"wms_sort\":4,\"toc_sort\":400,\"initially_visible\":true,\"queryable\":false},{\"id\":270751,\"geolion_gds\":66,\"geolion_geodatensatz_uuid\":\"3a95cd26-9125-22d1-9191-31e932c85e8c\",\"layer\":\"bauzonen\",\"group_title\":null,\"title\":\"Bauzonen\",\"mi