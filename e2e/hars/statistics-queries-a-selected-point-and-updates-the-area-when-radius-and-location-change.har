on_geodatensatz_uuid\":null,\"layer\":\"up24\",\"group_title\":null,\"title\":\"Übersichtsplan 1:2500\",\"min_scale\":1,\"max_scale\":1200,\"wms_sort\":9,\"toc_sort\":900,\"initially_visible\":true,\"queryable\":false},{\"id\":282419,\"geolion_gds\":95,\"geolion_geodatensatz_uuid\":\"e3edb411-868a-8e5f-3cc4-e962762543b8\",\"layer\":\"grenzen\",\"group_title\":null,\"title\":\"Bezirks- und Kantonsgrenzen\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":10,\"toc_sort\":9995,\"initially_visible\":true,\"queryable\":false},{\"id\":282420,\"geolion_gds\":95,\"geolion_geodatensatz_uuid\":\"e3edb411-868a-8e5f-3cc4-e962762543b8\",\"layer\":\"gemeindegrenzen\",\"group_title\":null,\"title\":\"Gemeindegrenzen\",\"min_scale\":1,\"max_scale\":200000,\"wms_sort\":11,\"toc_sort\":9994,\"initially_visible\":true,\"queryable\":true}],\"min_scale\":500},{\"topic\":\"StatBeschaeftigteZH\",\"title\":\"Beschäftigtenstatistik v1\",\"print_title\":\"Beschäftigtenstatistik v1\",\"icon\":\"/images/custom/themekl-statbeschaeftigtezh.gif\",\"organisation\":\"Statistisches Amt\",\"geolion_gdd\":null,\"geolion_karten_uuid\":null,\"keywords\":[\"Beschäftigtenstatistik\",\"v1\",\"stat\",\"beschäftigte\",\"statistik\",\"gebäude\",\"vollzeitäquivalente\",\"anzahl\",\"vollzeitäquivalente\",\"betriebe\",\"asd\"],\"notice\":\"Zur Unterstützung der Raum- und Verkehrsplanung werden die Daten detailliert auf Gebäudeebene bereitgestellt. Aus Datenschutzgründen wird für Gebäude mit weniger als vier Personen die exakte Personenzahl nicht angezeigt. Stattdessen wird in diesen Fällen der modellierte Wert von 2,1 verwendet. Dieser Wert entspricht dem gewichteten Durchschnitt aller Zürcher Haushalte mit ein bis drei Personen. Dieses Vorgehen minimiert die Abweichung von der tatsächlichen Einwohnerzahl in der jeweiligen Region.\",\"timesliderConfiguration\":null,\"filterConfigurations\":null,\"searchConfigurations\":null,\"wms_url\":\"https://maps.zh.ch/wms/StatBeschaeftigteZH\",\"gb2_url\":null,\"opacity\":0.7,\"layers\":[{\"id\":282941,\"geolion_gds\":null,\"geolion_geodatensatz_uuid\":null,\"layer\":\"stat-ent-f\",\"group_title\":null,\"title\":\"Beschäftigtenstatistik Fläche (Hektar)\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":0,\"toc_sort\":0,\"initially_visible\":true,\"queryable\":true},{\"id\":282942,\"geolion_gds\":null,\"geolion_geodatensatz_uuid\":null,\"layer\":\"stat-ent-p\",\"group_title\":null,\"title\":\"Beschäftigtenstatistik Punkt\",\"min_scale\":1,\"max_scale\":10000,\"wms_sort\":1,\"toc_sort\":100,\"initially_visible\":true,\"queryable\":true}],\"min_scale\":null},{\"topic\":\"StatBevoelkerungZH\",\"title\":\"Bevölkerungsstatistik v1\",\"print_title\":\"Bevölkerungsstatistik v1\",\"icon\":\"/images/custom/themekl-statbevoelkerungzh.gif\",\"organisation\":\"Statistisches Amt\",\"geolion_gdd\":null,\"geolion_karten_uuid\":null,\"keywords\":[\"Bevölkerungsstatistik\",\"v1\",\"stat\",\"bevölkerung\",\"statistik\",\"gebäude\",\"anzahl\",\"einwohner\",\"asd\"],\"notice\":\"Zur Unterstützung der Raum- und Verkehrsplanung werden die Daten detailliert auf Gebäudeebene bereitgestellt. Aus Datenschutzgründen wird für Gebäude mit weniger als vier Personen die exakte Personenzahl nicht angezeigt. Stattdessen wird in diesen Fällen der modellierte Wert von 2,1 verwendet. Dieser Wert entspricht dem gewichteten Durchschnitt aller Zürcher Haushalte mit ein bis drei Personen. Dieses Vorgehen minimiert die Abweichung von der tatsächlichen Einwohnerzahl in der jeweiligen Region.\",\"timesliderConfiguration\":null,\"filterConfigurations\":null,\"searchConfigurations\":null,\"wms_url\":\"https://maps.zh.ch/wms/StatBevoelkerungZH\",\"gb2_url\":null,\"opacity\":0.7,\"layers\":[{\"id\":282943,\"geolion_gds\":63,\"geolion_geodatensatz_uuid\":\"1bcd3db8-4b7d-4bcd-8d84-65124ea0dfbd\",\"layer\":\"stat-bev-f\",\"group_title\":null,\"title\":\"Bevölkerungsstatistik Fläche (Hektar)\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":0,\"toc_sort\":0,\"initially_visible\":true,\"queryable\":true},{\"id\":282944,\"geolion_gds\":null,\"geolion_geodatensatz_uuid\":null,\"layer\":\"stat-bev-p\",\"group_title\":null,\"title\":\"Bevölkerungsstatistik Punkt\",\"min_scale\":1,\"max_scale\":10000,\"wms_sort\":1,\"toc_sort\":100,\"initially_visible\":true,\"queryable\":true}],\"min_scale\":null},{\"topic\":\"AFMEinwBeschOVGKZH\",\"title\":\"Einwohner und Beschäftigte nach ÖV-Güteklassen\",\"print_title\":\"Einwohner und Beschäftigte nach ÖV-Güteklassen\",\"icon\":\"/images/custom/themekl-afmeinwbeschovgkzh.gif\",\"organisation\":\"AFM Verkehrsplanung\",\"geolion_gdd\":null,\"geolion_karten_uuid\":\"c5bb0935-ba2e-4271-82a4-d85f6a00dfd1\",\"keywords\":[\"Einwohner\",\"und\",\"Beschäftigte\",\"nach\",\"ÖV-Güteklassen\",\"Güteklassen\",\"ÖV-Güteklassen\",\"Einwohner\",\"Beschäftigte\",\"Bevölkerung\",\"Erschliessung\",\"ÖV\",\"OeV\",\"ÖVGK\",\"OeVGK\"],\"notice\":\"Für eine bessere Unterscheidung der Farben wird die schwarz-weisse Basiskarte empfohlen. Diese kann über die Schaltfläche in der unteren rechten Ecke des Ansichtsfensters ausgewählt werden. Die Karte zeigt hektargenaue Auswertungen zur Anz. Einwohner / Beschäftigte nach ÖV-Güteklassen (ÖVGK) des KtZH (Güteklasse A - F). Flächen mit den Werten 0, 1, 2 und 3 sind aus Datenschutzgründen vom Datensatz ausgeschlossen. Weiter Infos zur Datengrundlage sind den Metadaten zu entnehmen.\",\"timesliderConfiguration\":null,\"filterConfigurations\":[{\"name\":\"ÖV-Güteklassen des Kt. ZH\",\"parameter\":\"FILTER_GUETEKLASSE\",\"filterValues\":[{\"name\":\"A\",\"values\":[\"A\"]},{\"name\":\"B\",\"values\":[\"B\"]},{\"name\":\"C\",\"values\":[\"C\"]},{\"name\":\"D\",\"values\":[\"D\"]},{\"name\":\"E\",\"values\":[\"E\"]},{\"name\":\"F\",\"values\":[\"F\"]},{\"name\":\"keine ÖVGK\",\"values\":[\"ohne Gueteklasse\"]}]},{\"name\":\"Handlungsräumen nach Raumordnungskonzept (ROK-ZH)\",\"parameter\":\"FILTER_ROK\",\"filterValues\":[{\"name\":\"Stadtlandschaft\",\"values\":[\"Stadtlandschaft\"]},{\"name\":\