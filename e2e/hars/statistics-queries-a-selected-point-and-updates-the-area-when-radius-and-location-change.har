rchäologie\",\"geolion_gdd\":null,\"geolion_karten_uuid\":\"ad5c73a8-167f-4a8d-b888-3433e468fdf3\",\"keywords\":[\"Archäologische\",\"Zonen\",\"und\",\"Denkmalschutzobjekte\",\"bvv\",\"gwv\",\"imale\",\"pk\",\"TBAK1\",\"fsla\",\"123\",\"vp\",\"obs\",\"kurii\",\"fap\",\"denkk\"],\"notice\":\"Diese Karte zeigt Denkmalschutzobjekte, die in die Kompetenz der kantonalen Denkmalpflege fallen. Dazu gehören Bauten und Anlagen mitsamt der für ihre Wirkung wesentlichen Umgebung sowie wertvolle Park- und Gartenanlagen. Auch wenn ein Objekt in dieser Karte nicht gekennzeichnet ist, kann es sich um ein Schutzobjekt handeln. Kommunale Denkmalschutzobjekte fallen in die Kompetenz der Gemeinden. Die Publikation stellt keine Inventareröffnung im Sinne von § 209 Abs. 2 Planungs- und Baugesetz (PBG) dar.\",\"timesliderConfiguration\":null,\"filterConfigurations\":null,\"searchConfigurations\":[{\"index\":\"gvz\",\"title\":\"GVZ-Nr.\"}],\"wms_url\":\"https://maps.zh.ch/wms/ArchDenkmalZH\",\"gb2_url\":\"https://maps.zh.ch/?topic=ArchDenkmalZH\",\"opacity\":1,\"layers\":[{\"id\":282162,\"geolion_gds\":87,\"geolion_geodatensatz_uuid\":\"6d73814f-c8aa-0c08-55ee-bacff80a4cc4\",\"layer\":\"archaeologische-zonen\",\"group_title\":null,\"title\":\"Archäologische Zonen\",\"min_scale\":1,\"max_scale\":1000000,\"wms_sort\":1,\"toc_sort\":100,\"initially_visible\":true,\"queryable\":true},{\"id\":282163,\"geolion_gds\":517,\"geolion_geodatensatz_uuid\":\"c4caf5e8-7efc-48b0-b7a9-c6eb7e7a50df\",\"layer\":\"inv-umgebung\",\"group_title\":null,\"title\":\"Denkmalschutzobjekte Umgebung\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":2,\"toc_sort\":200,\"initially_visible\":true,\"queryable\":true},{\"id\":282165,\"geolion_gds\":517,\"geolion_geodatensatz_uuid\":\"c4caf5e8-7efc-48b0-b7a9-c6eb7e7a50df\",\"layer\":\"inv-objekte\",\"group_title\":null,\"title\":\"Denkmalschutzobjekte Inventar\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":4,\"toc_sort\":400,\"initially_visible\":true,\"queryable