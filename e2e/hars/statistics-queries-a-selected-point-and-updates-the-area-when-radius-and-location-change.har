. Der inhaltliche Schwerpunkt liegt auf Informationen zur baulichen Dichte, zur Landnutzung und zur Standortqualität.\\n\\n  Ebenen: Die Karte verfügt über zahlreiche ausgeblendete Ebenen, die sich via das kleine Dreiecksymbol links neben dem Karten-Icon einblenden lassen.\",\"timesliderConfiguration\":null,\"filterConfigurations\":null,\"searchConfigurations\":null,\"wms_url\":\"https://maps.zh.ch/wms/StatGewBauMoniZH\",\"gb2_url\":null,\"opacity\":1,\"layers\":[{\"id\":289703,\"geolion_gds\":487,\"geolion_geodatensatz_uuid\":\"6def3c3c-74b5-4053-bb62-e65ba2e34389\",\"layer\":\"standortqualitaet-gewerbebauland\",\"group_title\":null,\"title\":\"Standortqualität (Infoabfrage)\",\"min_scale\":1,\"max_scale\":500000,\"wms_sort\":0,\"toc_sort\":0,\"initially_visible\":true,\"queryable\":true},{\"id\":289704,\"geolion_gds\":487,\"geolion_geodatensatz_uuid\":\"6def3c3c-74b5-4053-bb62-e65ba2e34389\",\"layer\":\"flaecheninformation-gewerbebauland\",\"group_title\":null,\"title\":\"Flächeninformation (Infoabfrage)\",\"min_scale\":1,\"max_scale\":500000,\"wms_sort\":1,\"toc_sort\":100,\"initially_visible\":true,\"queryable\":true},{\"id\":289705,\"geolion_gds\":487,\"geolion_geodatensatz_uuid\":\"6def3c3c-74b5-4053-bb62-e65ba2e34389\",\"layer\":\"uebersicht-gewerbebauland\",\"group_title\":null,\"title\":\"Übersicht (Infoabfrage)\",\"min_scale\":1,\"max_scale\":500000,\"wms_sort\":2,\"toc_sort\":200,\"initially_visible\":true,\"queryable\":true},{\"id\":289706,\"geolion_gds\":487,\"geolion_geodatensatz_uuid\":\"6def3c3c-74b5-4053-bb62-e65ba2e34389\",\"layer\":\"weiterfuehrende_links\",\"group_title\":null,\"title\":\"Weiterführende Links (Infoabfrage)\",\"min_scale\":1,\"max_scale\":500000,\"wms_sort\":3,\"toc_sort\":300,\"initially_visible\":true,\"queryable\":true},{\"id\":289707,\"geolion_gds\":null,\"geolion_geodatensatz_uuid\":null,\"layer\":\"quartiere-gewerbebauland\",\"group_title\":null,\"title\":\"Quartiere\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":4,\"t