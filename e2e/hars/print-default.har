ations\":null,\"wms_url\":\"https://maps.zh.ch/wms/AwelAbflussschaetzwerteZH\",\"gb2_url\":null,\"opacity\":1,\"layers\":[{\"id\":285074,\"geolion_gds\":45,\"geolion_geodatensatz_uuid\":\"a5cdb294-8b76-70fc-1cf0-4c9e2271a0c1\",\"layer\":\"fliessgewaesser\",\"group_title\":null,\"title\":\"Fliessgewässer\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":0,\"toc_sort\":0,\"initially_visible\":true,\"queryable\":true},{\"id\":285075,\"geolion_gds\":588,\"geolion_geodatensatz_uuid\":\"5e4f0fb0-a592-49a4-a1ec-af9a88749d26\",\"layer\":\"q-median-q182-gewaesser-stadt-zh\",\"group_title\":null,\"title\":\"Q Median Stadt Zürich (Q182)\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":1,\"toc_sort\":100,\"initially_visible\":false,\"queryable\":true},{\"id\":285076,\"geolion_gds\":588,\"geolion_geodatensatz_uuid\":\"5e4f0fb0-a592-49a4-a1ec-af9a88749d26\",\"layer\":\"q-mittel-qm-gewaesser-stadt-zh\",\"group_title\":null,\"title\":\"Q Mittel Stadt Zürich (MQ)\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":2,\"toc_sort\":200,\"initially_visible\":true,\"queryable\":true},{\"id\":285077,\"geolion_gds\":588,\"geolion_geodatensatz_uuid\":\"5e4f0fb0-a592-49a4-a1ec-af9a88749d26\",\"layer\":\"q-347-gewaesser-stadt-zh\",\"group_title\":null,\"title\":\"Q347 Stadt Zürich\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":3,\"toc_sort\":300,\"initially_visible\":true,\"queryable\":true},{\"id\":285078,\"geolion_gds\":588,\"geolion_geodatensatz_uuid\":\"5e4f0fb0-a592-49a4-a1ec-af9a88749d26\",\"layer\":\"q-median-q182-kt-zh\",\"group_title\":null,\"title\":\"Q Median (Q182)\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":4,\"toc_sort\":400,\"initially_visible\":false,\"queryable\":true},{\"id\":285079,\"geolion_gds\":588,\"geolion_geodatensatz_uuid\":\"5e4f0fb0-a592-49a4-a1ec-af9a88749d26\",\"layer\":\"q-mittel-qm-kt-zh\",\"group_title\":null,\"title\":\"Q Mittel (MQ)\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":5,\"toc_sort\":500,\"initially_visible\":true,\"queryable\":true},{\"id\":285080,\"geolion_gds\":588,\"geolion_geodatensatz_uuid\":\"5e4f0fb0-a592-49a4-a1ec-af9a88749d26\",\"layer\":\"q-347-kt-zh\",\"group_title\":null,\"title\":\"Q347\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":6,\"toc_sort\":600,\"initially_visible\":true,\"queryable\":true},{\"id\":285081,\"geolion_gds\":483,\"geolion_geodatensatz_uuid\":\"e7c38842-5fe0-4db8-b743-da5c35a02b37\",\"layer\":\"stationen\",\"group_title\":null,\"title\":\"Abflussmessstationen\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":7,\"toc_sort\":700,\"initially_visible\":true,\"queryable\":true}],\"min_scale\":null},{\"topic\":\"AWELGSMessstellenwwwZH\",\"title\":\"Messstellen Fliessgewässer-Monitoring\",\"print_title\":\"Messstellen Fliessgewässer-Monitoring\",\"icon\":\"/images/custom/themekl-awelgsmessstellenwwwzh.gif\",\"organisation\":\"AWEL Wasserbau Geoinformation und Hydrometrie\",\"geolion_gdd\":null,\"geolion_karten_uuid\":\"481d2ff6-bf45-4922-93da-f87bdc63c09d\",\"keywords\":[\"Messstellen\",\"Fliessgewässer-Monitoring\",\"Messstellen\",\"Monitoring\"],\"notice\":\"Das Messprogramm ist historisch gewachsen. Chemische Daten gibt es für einzelne Messtellen bereits seit Mitte der 1970-er Jahre in unterschiedlichen Zeitabständen. Erste biologische Untersuchungen begannen Mitte der 1990-er Jahre. Bis 2017 fanden die biologischen Untersuchungen in unregelmässigen Zeitabständen alle 4 – 6 Jahre statt. Seit 2018 werden die biologischen Untersuchungen alle vier Jahre durchgeführt.\",\"timesliderConfiguration\":null,\"filterConfigurations\":null,\"searchConfigurations\":null,\"wms_url\":\"https://maps.zh.ch/wms/AWELGSMessstellenwwwZH\",\"gb2_url\":null,\"opacity\":1,\"layers\":[{\"id\":272816,\"geolion_gds\":45,\"geolion_geodatensatz_uuid\":\"a5cdb294-8b76-70fc-1cf0-4c9e2271a0c1\",\"layer\":\"gewaesser\",\"group_title\":null,\"title\":\"Gewässer\",\"min_scale\":1,\"max_scale\":100000,\"wms_sort\":12,\"toc_sort\":1200,\"initially_visible\":true,\"queryable\":tru