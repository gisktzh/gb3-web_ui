s_sort\":4,\"toc_sort\":400,\"initially_visible\":true,\"queryable\":true},{\"id\":278834,\"geolion_gds\":216,\"geolion_geodatensatz_uuid\":\"6ba8a9ab-78f4-4f75-b24c-020d85081fb2\",\"layer\":\"zivilstandskreise\",\"group_title\":null,\"title\":\"Zivilstandsamt/-kreis\",\"min_scale\":1,\"max_scale\":1500000,\"wms_sort\":5,\"toc_sort\":500,\"initially_visible\":true,\"queryable\":true},{\"id\":278835,\"geolion_gds\":565,\"geolion_geodatensatz_uuid\":\"362885b6-5a96-4dab-b89c-3bc11bae596a\",\"layer\":\"friedhof_standorte\",\"group_title\":null,\"title\":\"Friedhöfe Standorte\",\"min_scale\":1,\"max_scale\":50000,\"wms_sort\":6,\"toc_sort\":600,\"initially_visible\":true,\"queryable\":true}],\"min_scale\":null}]},{\"title\":\"Raumplanung, Zonenpläne\",\"topics\":[{\"topic\":\"StatArbZonBewZH\",\"title\":\"Arbeitszonenbewirtschaftung\",\"print_title\":\"Arbeitszonenbewirtschaftung\",\"icon\":\"/images/custom/themekl-statarbzonbewzh.gif\",\"organisation\":\"Statistisches Amt\",\"geolion_gdd\":null,\"geolion_karten_uuid\":\"c47d43a3-db63-41a0-ae1a-5a9c213b13f9\",\"keywords\":[\"Arbeitszonenbewirtschaftung\",\"asd\",\"statistik\"],\"notice\":\"Die Daten zeigen zentrale Merkmale zum Stand der Gewerbeentwicklung auf Quartierebene. Der inhaltliche Schwerpunkt liegt auf den Industrie- und Gewerbezonen. Die Inhalte der Karte sind so abgestimmt, dass sie als Grundlage für die Ausscheidung neuer Arbeitszonen dienen (Arbeitszonenbewirtschaftung).  Ebenen: Die Karte verfügt über zahlreiche ausgeblendete Ebenen, die sich via das kleine Dreiecksymbol links neben dem Karten-Icon einblenden lassen. Hervorheben des selektierten Quartiers: Wird ein Gebiet selektiert, so wird dieses gelb hervorgehoben, sobald man mit der Maus über die Infoabfrage navigiert. Dies ist relevant, weil ein Gebiet mehrere Quartiere umfassen kann.\",\"timesliderConfiguration\":null,\"filterConfigurations\":null,\"searchConfigurations\":null,\"wms_url\":\"https://maps.zh.ch/wms/StatArbZonBewZH\",\"gb2_url\":null,\