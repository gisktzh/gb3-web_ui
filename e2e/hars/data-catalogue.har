            "mimeType": "application/json; charset=utf-8",
            "text": "{\"dataset\":{\"uuid\":\"fd353bb7-fa7f-3666-c190-307aa524a43c\",\"image_url\":{\"src\":{\"href\":\"https://maps.zh.ch/gb3/v4/metadata/datasets/fd353bb7-fa7f-3666-c190-307aa524a43c/image\"},\"alt\":\"\",\"url\":{\"href\":\"https://maps.zh.ch/gb3/v4/metadata/datasets/fd353bb7-fa7f-3666-c190-307aa524a43c/image\"}},\"ogd\":true,\"kontakt_geodaten\":{\"amt\":\"Amt für Abfall, Wasser, Energie und Luft\",\"fachstelle\":\"Abteilung Wasserbau\",\"sektion\":null,\"vorname\":\"Christian\",\"nachname\":\"Schuler\",\"strassenname\":\"Walcheplatz\",\"hausnummer\":2,\"postfach\":null,\"plz\":8090,\"ortschaft\":\"Zürich\",\"telephon\":\"+41 43 259 32 24\",\"telephon_direkt\":\"+41 43 259 44 35\",\"email\":{\"title\":\"christian.schuler@bd.zh.ch\",\"href\":\"mailto:christian.schuler@bd.zh.ch\"},\"weburl\":{\"title\":\"https://www.zh.ch/de/umwelt-tiere/wasser-gewaesser.html\",\"href\":\"https://www.zh.ch/de/umwelt-tiere/wasser-gewaesser.html\"}},\"kontakt_metadaten\":{\"amt\":\"Amt für Abfall, Wasser, Energie und Luft\",\"fachstelle\":\"Abteilung Wasserbau\",\"sektion\":null,\"vorname\":\"Maja\",\"nachname\":\"Rapp\",\"strassenname\":\"Walcheplatz\",\"hausnummer\":2,\"postfach\":null,\"plz\":8090,\"ortschaft\":\"Zürich\",\"telephon\":\"+41 43 259 32 24\",\"telephon_direkt\":\"043 259 32 55\",\"email\":{\"title\":\"maja.rapp@bd.zh.ch\",\"href\":\"mailto:maja.rapp@bd.zh.ch\"},\"weburl\":{\"title\":\"https://www.zh.ch/de/umwelt-tiere/wasser-gewaesser.html\",\"href\":\"https://www.zh.ch/de/umwelt-tiere/wasser-gewaesser.html\"}},\"giszhnr\":250,\"name\":\"Abflussprozesskarte\",\"kurzbeschreibung\":\"Die Abflussprozesskarte zeigt die Flächen der Abflussprozesse.\",\"beschreibung\":\"Die Abflussprozesskarte zeigt die Flächen der dominanten Abflussprozesse, hortonscher Oberflächenabfluss, Sättigungsoberflächenabfluss, laterale unterirdische Entwässerung, Drainagen und Tiefenversickerung. In einem zweiten Layer sind Flächen dargestellt, die bei intensiven Starkniederschlägen zu schnellem Oberflächenabfluss neigen (potentielle HOF-Flächen).\",\"themen\":[\"Höhen\",\"Boden\",\"Geologie\",\"Gewässer\"],\"keywords\":[\"Abluss\",\"Oberflächenabfluss\",\"Sättigung\",\"Drainage\",\"Tiefensickerung\"],\"datenstand\":\"15.08.2006\",\"nachfuehrungstyp\":\"nicht geplant\",\"bearbeitungstatus\":\"komplett\",\"geogausdehnung\":\"Kanton Zürich\",\"erfassungsmasstab\":10000,\"aufloesung\":null,\"lagegenauigkeit\":5,\"gesetzklasse\":\"IV Kantonsrecht / -zuständigkeit\",\"geobasisdaten\":{\"title\":\"100-ZH\",\"href\":\"https://geobasisdaten.ch/detail/818566\"},\"url_shop\":null,\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"ESRI File Geodatabase (.gdb)\",\"Comma separated text (.csv)\",\"DXF (.dxf)\",\"GeoPackage (.gpkg)\"],\"datenerfassung\":null,\"datengrundlage\":\"Die Karte wurde 2006 aus der Bodenkarte 1:5000 des Kantons Zürich abgeleitet. Es ist eine Modellierung, welche mit den hydrometrischen Messungen und weiteren Detailuntersuchungen geeicht wurde.\",\"documentationhtml\":null,\"pdf\":{\"title\":\"Abflussprozesskarte, Fachartikel WEL, 2007 Heft 3.pdf\",\"href\":\"https://maps.zh.ch/gb3/v4/metadata/datasets/fd353bb7-fa7f-3666-c190-307aa524a43c/pdf\"},\"bemerkungen\":\"Die Daten stehen wie beschrieben als shape-File (Vektor), aber auch als ESRI-Grid (Raster) zur Verfügung.\",\"geocat\":{\"title\":\"https://www.geocat.ch/geonetwork/srv/ger/catalog.search#/metadata/fd353bb7-fa7f-3666-c190-307aa524a43c\",\"href\":\"https://www.geocat.ch/geonetwork/srv/ger/catalog.search#/metadata/fd353bb7-fa7f-3666-c190-307aa524a43c\"},\"opendataswiss\":{\"title\":\"http://opendata.swiss/de/perma/fd353bb7-fa7f-3666-c190-307aa524a43c@geoinformation-kanton-zuerich\",\"href\":\"http://opendata.swiss/de/perma/fd353bb7-fa7f-3666-c190-307aa524a43c@geoinformation-kanton-zuerich\"},\"mxd\":null,\"lyrs\":[],\"maps\":[{\"uuid\":\"9f622fad-d093-4026-9634-229559e34b22\",\"gb2_id\":2003,\"topic\":\"AwelWbAbflussZH\",\"name\":\"Abflussprozesskarte\"}],\"layers\":[{\"name\":\"Gewässer Abflussprozesse\",\"giszhnr\":\"250.1\",\"beschreibung\":\"Abflussprozesse\",\"geometrietyp\":\"Fläche\",\"pfadfilename\":\"rofa.giszhpub.wb_abflussprozesse_f\",\"metadaten_sichtbarkeit\":\"Internet\",\"datenbezugart\":\"OGD - freie Nutzung und Weitergabe\",\"attribute\":[{\"name\":\"abkuerzung\",\"typ\":\"String\",\"einheit\":null,\"beschreibung\":\"SSF3, SSF2, SSF1, SOF3, SOF2, SOF1, Hof2, Hof1, DP, D3, D2, D1 \\r\\nErklärungen dazu siehe unter Attribut Beschreibung_D (=deutsch) und Beschreibung_E (=englisch)\"},{\"name\":\"beschreibung_d\",\"typ\":\"String\",\"einheit\":null,\"beschreibung\":\"DP = Langsamer, unterirdischer Abfluss oder Grundwasseranreicherung (Boden-Speichervermögen sehr gross)\\r\\nD3 = Leicht geneigte Flächen mit Drainagenabfluss (Boden-Speichervermögen gross)\\r\\nD2 = Leicht geneigte Flächen mit Drainagenabfluss (Boden-Speichervermögen mittel)\\r\\nD1 = Leicht geneigte Flächen mit Drainagenabfluss (Boden-Speichervermögen klein)\\r\\nSOF3 = Stark verzögerter Oberflächenabfluss (Boden-Speichervermögen mittel)\\r\\nSOF2 = Leicht verzögerter Oberflächenabfluss (Boden-Speichervermögen mittel)\\r\\nSOF1 = Unmittelbarer Oberflächenabfluss (Boden-Speichervermögen klein)\\r\\nHOF2 = Oberflächenabfluss, leicht verzögert (Beinahe-Versiegelung)\\r\\nHOF1 = Oberflächenabfluss, unmittelbar (Versiegelte Flächen)\\r\\nSSF3 = Stark verzögerter unterirdischer Abfluss (Boden-Speichervermögen gross)\\r\\nSSF2 = Verzögerter unterirdischer Abfluss (Boden-Speichervermögen mittel)\\r\\nSSF1 = Unmittelbarer unterirdischer Abfluss (Boden-Speichervermögen klein)\\r\\n<NULL> = Seen\\r\\n<NULL> = Siedlungsgebiet\\r\\n<NULL> = Strassen\"},{\"name\":\"beschreibung_e\",\"typ\":\"String\",\"einheit\":null,\"beschreibung\":\"D1 = Drained-Area Flow 1\\r\\nD2 = Drained-Area Flow 2\\r\\nD3 = Drained-Area Flow 3\\r\\nHOF1 = Hortonian overland flow (sealed areas)\\r\\nHOF2 = Hortonian overland flow (limited infiltration possible)\\r\\nDP = Slow Subsurface Flow\\r\\nSSF1 = Subsurface Flow 1\\r\\nSSF2 = Subsurface Flow 2\\r\\nSSF3 = Subsurface Flow 3\\r\\nSOF1 = Surface Overland Flow 1\\r\\nSOF2 = Surface Overland Flow 2\\r\\nSOF3 = Surface Overland Flow 3\\r\\n\"},{\"name\":\"objectid\",\"typ\":\"Long Integer\",\"einheit\":null,\"beschreibung\":\"Interne Objektnummer\"},{\"name\":\"shape\",\"typ\":\"Shape\",\"einheit\":null,\"beschreibung\":\"Polygon\"}]},{\"name\":\"Gewässer Unmittelbarer Oberflächenabfluss\",\"giszhnr\":\"250.3\",\"beschreibung\":\"Unmittelbarer Oberflächenabfluss\",\"geometrietyp\":\"Fläche\",\"pfadfilename\":\"rofa.giszhpub.wb_abflussprozess_hof_f\",\"metadaten_sichtbarkeit\":\"Internet\",\"datenbezugart\":\"OGD - freie Nutzung und Weitergabe\",\"attribute\":[{\"name\":\"abkuerzung\",\"typ\":\"String\",\"einheit\":null,\"beschreibung\":\"HOF (= Hortonian overland flow)\"},{\"name\":\"beschreibung_d\",\"typ\":\"String\",\"einheit\":null,\"beschreibung\":\"Oberflächenabfluss, unmittelbar (Infiltration gehemmt, Hortonscher Oberflächenabfluss)\"},{\"name\":\"beschreibung_e\",\"typ\":\"String\",\"einheit\":null,\"beschreibung\":\"Hortonian overland flow (limited infiltration possible)\"},{\"name\":\"objectid\",\"typ\":\"Long Integer\",\"einheit\":null,\"beschreibung\":\"Interne Objektnummer\"},{\"name\":\"shape\",\"typ\":\"Shape\",\"einheit\":null,\"beschreibung\":\"POLYGON\"},{\"name\":\"gridcode\",\"typ\":\"Short Integer\",\"einheit\":null,\"beschreibung\":\"50 = HOF (= Hortonian overland flow)\"}]}],\"services\":[{\"uuid\":\"5b4f171e-f069-11e7-8c3f-9a214cf093ae\",\"gdsernummer\":16,\"servicetyp\":\"WFS\",\"name\":\"Allgemeiner WFS für Open-Government-Data des Kantons Zürich (OGD ZH WFS)\"},{\"uuid\":\"bd5e8184-0036-4319-a258-3b44183ec9a5\",\"gdsernummer\":889,\"servicetyp\":\"WMS\",\"name\":\"WMS Abflussprozesskarte (OGD)\"}],\"products\":[]}}"
