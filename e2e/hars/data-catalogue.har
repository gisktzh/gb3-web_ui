efile (.shp)\",\"GeoPackage (.gpkg)\"],\"ogd\":false},{\"uuid\":\"a08444e4-6eca-e9ce-8fcc-7da0e41e5f49\",\"kurzbeschreibung\":\"Übersicht über die Strassenlärmbelastung an Kantonsstrassen aggregiert auf 100m Abschnitte in Landgemeinden ohne Städte Zürich und Winterthur.\",\"name\":\"Belastungsmass Strassenlärm\",\"kontakt_metadaten\":{\"amt\":\"Tiefbauamt\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"ESRI File Geodatabase (.gdb)\",\"GeoPackage (.gpkg)\"],\"ogd\":false},{\"uuid\":\"888cdf28-4717-4adb-a24f-d2893ca11623\",\"kurzbeschreibung\":\"Beleuchtungskataster Staatsstrassen (ohne Städte Zürich und Winterthur)\",\"name\":\"Beleuchtung\",\"kontakt_metadaten\":{\"amt\":\"Tiefbauamt\"},\"abgabeformate\":[\"GeoPackage (.gpkg)\",\"ESRI File Geodatabase (.gdb)\",\"ESRI Shapefile (.shp)\",\"Comma separated text (.csv)\",\"DXF (.dxf)\"],\"ogd\":true},{\"uuid\":\"71523d9a-062c-3d80-adac-a58496293c78\",\"kurzbeschreibung\":\"Über das WebGIS BUN werden die jährlichen Unterhaltsarbeiten in den überkommunalen Naturschutzgebieten des Kanton Zürich in zahlreichen Gedatenebenen geplant und dokumentiert.\",\"name\":\"Betreuungs- und Unterhaltsdokumentation für überkommunale Naturschutzgebiete - BUN\",\"kontakt_metadaten\":{\"amt\":\"Amt für Landschaft und Natur\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\"],\"ogd\":false},{\"uuid\":\"9933d78f-c06d-c0c8-6851-425cf2a892ce\",\"kurzbeschreibung\":\"Die GIS-Ebene Betriebliche Bestandeskarten im Kanton Zürich ist der Zusammenzug der einzelnen Bestandeskarten, welche im Rahmen der gesetzlich vorgeschriebenen Betriebsplanrevisionen erstellt wurden. \",\"name\":\"Betriebliche Bestandeskarten\",\"kontakt_metadaten\":{\"amt\":\"Amt für Landschaft und Natur\"},\"abgabeformate\":[\"ESRI File Geodatabase (.gdb)\",\"ESRI Shapefile (.shp)\",\"DXF (.dxf)\",\"Comma separated text (.csv)\",\"GeoPackage (.gpkg)\"],\"ogd\":true},{\"uuid\":\"7824ee28-e909-460e-bb69-407ead120f5a\",\"kurzbeschreibung\":\"Registrierten Bienenstände im Kanton Zürich sowie ausserkantonale Bienenstände von Zürcher Imker und Imkerinnen (OGD) mit Anzahl Völker (NOGD).\",\"name\":\"Bienenstände\",\"kontakt_metadaten\":{\"amt\":\"Veterinäramt\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\"],\"ogd\":true},{\"uuid\":\"ac87d334-7579-ca8c-8466-0cd3226bfa49\",\"kurzbeschreibung\":\"Qualitative Beschaffenheit der landwirtschaftlich genutzten Flächen. Natürliche bodenkundliche Verhältnisse, Beurteilung bzgl. landw. Nutzungseignung und Risiko für Nährstoffverluste sowie zugehörige Bodenprofil-Datenbank. Erhebungen 1989-96.\",\"name\":\"Bodenkartierung der Landwirtschaftsflächen\",\"kontakt_metadaten\":{\"amt\":\"Amt für Landschaft und Natur\"},\"abgabeformate\":[\"ESRI File Geodatabase (.gdb)\",\"ESRI Shapefile (.shp)\"],\"ogd\":true},{\"uuid\":\"2f1ba77a-26fc-4a6f-b617-a0559a700093\",\"kurzbeschreibung\":\"Bodenkundliche Aufnahmen zur qualitativen Beschaffenheit der Waldböden mit Fokus auf Gebiete mit starker Bodenversauerung. Erhebungen 2013-2022 (Teilgebiet der gesamten Waldfläche)\",\"name\":\"Bodenkartierung der Waldflächen (Teilgebiet)\",\"kontakt_metadaten\":{\"amt\":\"Amt für Landschaft und Natur\"},\"abgabeformate\":[\"ESRI File Geodatabase (.gdb)\",\"ESRI Shapefile (.shp)\"],\"ogd\":true},{\"uuid\":\"7e480b7e-3fd5-d9f7-854b-5fdab17ed4fd\",\"kurzbeschreibung\":\"Inventar der Denkmalschutzobjekte von überkommunaler Bedeutung\",\"name\":\"Denkmalschutzobjekte\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"GeoPackage (.gpkg)\",\"Comma separated text (.csv)\",\"DXF (.dxf)\",\"ESRI File Geodatabase (.gdb)\"],\"ogd\":true},{\"uuid\":\"c4caf5e8-7efc-48b0-b7a9-c6eb7e7a50df\",\"kurzbeschreibung\":\"Polygone zum Inventar der Denkmalschutzobjekte von überkommunaler Bedeutung\",\"name\":\"Denkmalschutzobjekte Polygone (OGD)\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\"],\"ogd\":true},{\"uuid\":\"ca9d4f10-d381-4f53-8e45-8d92