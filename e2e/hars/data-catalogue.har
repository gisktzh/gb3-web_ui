          "content": {
            "size": -1,
            "mimeType": "application/json; charset=utf-8",
            "text": "{\"datasets\":[{\"uuid\":\"fd353bb7-fa7f-3666-c190-307aa524a43c\",\"kurzbeschreibung\":\"Die Abflussprozesskarte zeigt die Flächen der Abflussprozesse.\",\"name\":\"Abflussprozesskarte\",\"kontakt_metadaten\":{\"amt\":\"Amt für Abfall, Wasser, Energie und Luft\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"ESRI File Geodatabase (.gdb)\",\"Comma separated text (.csv)\",\"DXF (.dxf)\",\"GeoPackage (.gpkg)\"],\"ogd\":true},{\"uuid\":\"5e4f0fb0-a592-49a4-a1ec-af9a88749d26\",\"kurzbeschreibung\":\"Abschätzung der Abflusswerte Q347, Q182 und MQ für die Einzugsgebiete (EZG) des\\nKantons sowie für die Schwachstellen der Stadt Zürich\",\"name\":\"Abflussschätzwerte: Niedrig- und Mittelwasserabflüsse Q347, Q182 und MQ\",\"kontakt_metadaten\":{\"amt\":\"Amt für Abfall, Wasser, Energie und Luft\"},\"abgabeformate\":[\"ESRI File Geodatabase (.gdb)\",\"GeoPackage (.gpkg)\",\"ESRI Shapefile (.shp)\"],\"ogd\":false},{\"uuid\":\"b0c12699-4055-58e2-2627-7175f9fddaa6\",\"kurzbeschreibung\":\"Adressen der Amtlichen Vermessung\",\"name\":\"Adressen GIS-ZH\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"DXF (.dxf)\",\"GeoPackage (.gpkg)\",\"Comma separated text (.csv)\",\"ESRI File Geodatabase (.gdb)\"],\"ogd\":true},{\"uuid\":\"ceef52f1-6354-4a60-8693-d1c30e8e1a29\",\"kurzbeschreibung\":\"Die Geodaten «Agglomerationsprogramme Kanton Zürich» sind ein Teil der Grundlagen zur Verwaltung, Analyse und Qualitätssicherung der Massnahmen der Agglomerationsprogramme der 1., 2., 3., 4. und 5. Generation.\",\"name\":\"Agglomerationsprogramme Kanton Zürich\",\"kontakt_metadaten\":{\"amt\":\"Amt für Mobilität\"},\"abgabeformate\":[\"ESRI File Geodatabase (.gdb)\",\"GeoPackage (.gpkg)\"],\"ogd\":false},{\"uuid\":\"916df4dc-740b-4644-989b-21c818fff536\",\"kurzbeschreibung\":\"Teilpopulationsstandorte der vom Aktionsplan Fora behandelten Arten im Kanton Zürich sowie die Massnahmen- und Kontroll-Informationen.\",\"name\":\"Aktionsplan Flora\",\"kontakt_metadaten\":{\"amt\":\"Amt für Landschaft und Natur\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\"],\"ogd\":false},{\"uuid\":\"a6a212c3-df49-48f6-a815-425b0dac4c03\",\"kurzbeschreibung\":\"Zonen und Gebiete bei aktuellen Tierseuchenfällen\",\"name\":\"Aktuelle Zonierung Tierseuchen\",\"kontakt_metadaten\":{\"amt\":\"Veterinäramt\"},\"abgabeformate\":[\"ESRI File Geodatabase (.gdb)\"],\"ogd\":false},{\"uuid\":\"0c6c5482-2f57-ed6f-c155-e04783a5ad60\",\"kurzbeschreibung\":\"Alte Landeskarte 1:25'000 1956 - 1965 swisstopo\",\"name\":\"Alte Landeskarte 1:25'000 1956 - 1965 (swisstopo)\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"GeoTIFF/Worldfile (.tif/.tfw)\"],\"ogd\":false},{\"uuid\":\"5b389555-c3fc-34e4-4d11-de7a0f542ea9\",\"kurzbeschreibung\":\"Amphibienzugstellen im Kanton Zürich (Auszug Datenbank von info fauna)\",\"name\":\"Amphibienzugstellen\",\"kontakt_metadaten\":{\"amt\":\"Amt für Landschaft und Natur\"},\"abgabeformate\":[\"GeoPackage (.gpkg)\",\"Comma separated text (.csv)\",\"DXF (.dxf)\",\"ESRI File Geodatabase (.gdb)\",\"ESRI Shapefile (.shp)\"],\"ogd\":true},{\"uuid\":\"f5986cb5-f1df-42ee-a6c6-cff74c4c53ab\",\"kurzbeschreibung\":\"Der Basisplan der amtlichen Vermessung (BP-AV) ist ein schweizweit einheitliches Produkt und wird automatisch aus den Daten der amtlichen Vermessung abgeleitet für den Massstabsbereich 1:2'500 bis 1:15'000. \",\"name\":\"Amtliche Vermessung, Basisplan (BP-AV)\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"GeoTIFF/Worldfile (.tif/.tfw)\"],\"ogd\":true},{\"uuid\":\"bb4977ba-d158-4b75-824a-8daa8030c5d8\",\"kurzbeschreibung\":\"Die Informationsebene Bodenbedeckung ist eine generalisierte, flächige Darstellung der realen Erdoberfläche\",\"name\":\"Amtliche Vermessung; Bodenbedeckung DM01AVZH24\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"DXF (.dxf)\",\"ESRI Shapefile (.shp)\",\"INTERLIS1 (.ili/.itf)\",\"GeoPackage (.gpkg)\"],\"ogd\":true},{\"uuid\":\"a2465a5b-e7d3-487d-b32c-a2665f940e99\",\"kurzbeschreibung\":\"Die Informationsebene Einzelobjekte ist eine generalisierte Darstellung von realen Objekten \",\"name\":\"Amtliche Vermessung; Einzelobjekte DM01AVZH24\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"DXF (.dxf)\",\"GeoPackage (.gpkg)\",\"INTERLIS1 (.ili/.itf)\"],\"ogd\":true},{\"uuid\":\"9989f45d-4351-41a4-a35c-843ce65c7d2e\",\"kurzbeschreibung\":\"Fixpunkte sind dauerhaft versicherte Referenzpunkte zum Koordinatenbezugsrahmen LV95\",\"name\":\"Amtliche Vermessung; Fixpunkte DM01AVZH24 \",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"GeoPackage (.gpkg)\",\"ESRI Shapefile (.shp)\",\"INTERLIS1 (.ili/.itf)\",\"DXF (.dxf)\"],\"ogd\":true},{\"uuid\":\"015de79b-fe93-438d-b08e-df0e5cb2eaa1\",\"kurzbeschreibung\":\"Die Informationsebene Gebäudeadresse beinhaltet die Lokalisation (Strasse, Platz, benanntes Gebiet) und die Hausnummer eines Gebäudes. \",\"name\":\"Amtliche Vermessung; Gebäudeadressen DM01AVZH24 \",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"GeoPackage (.gpkg)\",\"DXF (.dxf)\",\"INTERLIS1 (.ili/.itf)\"],\"ogd\":true},{\"uuid\":\"b8aefb29-cf62-4014-bbcd-0b89595b6b15\",\"kurzbeschreibung\":\"Die Hoheitsgrenzen sind die Grenzen der politischen Gemeinden, der Bezirke, der Kantone und des Landes\",\"name\":\"Amtliche Vermessung; Hoheitsgrenzen DM01AVZH24  \",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"GeoPackage (.gpkg)\",\"INTERLIS1 (.ili/.itf)\",\"ESRI Shapefile (.shp)\",\"DXF (.dxf)\"],\"ogd\":true},{\"uuid\":\"fd6312b7-9e7a-40f5-9200-49d5e4b8fb4d\",\"kurzbeschreibung\":\"Die Informationsebene Liegenschaften enthält die Grundstücke der rechtsgültigen und projektierten Liegenschaften sowie der selbständigen und dauernden Rechte (sdR) wie z.B. Baurecht und Bergwerke.\",\"name\":\"Amtliche Vermessung; Liegenschaften DM01AVZH24  \",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"DXF (.dxf)\",\"ESRI Shapefile (.shp)\",\"GeoPackage (.gpkg)\",\"INTERLIS1 (.ili/.itf)\"],\"ogd\":true},{\"uuid\":\"1bb59bc6-a2ba-4b6e-bea3-388817cc8dd3\",\"kurzbeschreibung\":\"Flur-, Orts- und Geländenamen (= geografische Namen der amtlichen Vermessung) von geografischen Gebieten, Landschaftsteilen, Flurstücken, topografischen Objekten \",\"name\":\"Amtliche Vermessung; Nomenklatur DM01AVZH24 \",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"DXF (.dxf)\",\"GeoPackage (.gpkg)\",\"ESRI Shapefile (.shp)\",\"INTERLIS1 (.ili/.itf)\"],\"ogd\":true},{\"uuid\":\"4f2acb54-69d6-47a1-853e-d60367856c70\",\"kurzbeschreibung\":\"Die Informationsebene PLZOrtschaft beinhaltet die Gebiete der postalischen Ortschaften und Postleitzahlen. \",\"name\":\"Amtliche Vermessung; Postleitzahl / Ortschaften DM01AVZH24 \",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"INTERLIS1 (.ili/.itf)\",\"ESRI Shapefile (.shp)\",\"DXF (.dxf)\",\"GeoPackage (.gpkg)\"],\"ogd\":true},{\"uuid\":\"e35e0cdd-da5b-4b7e-a927-5d2a8a5c2fc6\",\"kurzbeschreibung\":\"In der Informationsebene Rohrleitungen werden Ölleitungen, Gasleitungen sowie weitere Leitungen nach dem eidgenössischen Rohrleitungsgesetz (RLG, SR 746.1) resp. der eidgenössischen Rohrleitungsverordnung (RLV, SR 746.11) erhoben. \",\"name\":\"Amtliche Vermessung; Rohrleitungen DM01AVZH24 \",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"GeoPackage (.gpkg)\",\"ESRI Shapefile (.shp)\",\"INTERLIS1 (.ili/.itf)\",\"DXF (.dxf)\"],\"ogd\":true},{\"uuid\":\"1ae94d14-30ac-47e0-aef1-30f7886de509\",\"kurzbeschreibung\":\"Im Rahmen der VBUG, LS 722.11, anrechenbare Gemeindestrassen.\",\"name\":\"Anrechenbare Gemeindestrassen (gemäss VBUG, LS 722.11)\",\"kontakt_metadaten\":{\"amt\":\"Amt für Mobilität\"},\"abgabeformate\":[\"GeoPackage (.gpkg)\",\"ESRI File Geodatabase (.gdb)\",\"ESRI Shapefile (.shp)\"],\"ogd\":false},{\"uuid\":\"803dbb8a-65c6-4d3b-bcda-6c899c605adf\",\"kurzbeschreibung\":\"Die Karte zeigt Beobachtungen von (invasiven) aquatischen Neozoen sowie ausgehend von diesen Beobachtungen Fliessgewässer bzw. Seen, die (potentiell) mit invasiven aquatischen Neozoen belastet sind.\",\"name\":\"Aquatische Neozoen\",\"kontakt_metadaten\":{\"amt\":\"Amt für Abfall, Wasser, Energie und Luft\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\"],\"ogd\":false},{\"uuid\":\"3b8b3199-0bce-4dbb-a584-c5043e890ba3\",\"kurzbeschreibung\":\"Standorte der aktuellen ARA und Kleinkläranlagen (KLARA) sowie ARA-Einzugsgebiete\\n\",\"name\":\"ARA, ARA-Einzugsgebiete und Versickerungskarte (GEP)\",\"kontakt_metadaten\":{\"amt\":\"Amt für Abfall, Wasser, Energie und Luft\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\"],\"ogd\":false},{\"uuid\":\"f81abab6-f732-45e4-9b35-0008a0d07322\",\"kurzbeschreibung\":\"Arbeitszonenbewirtschaftung\",\"name\":\"Arbeitszonenbewirtschaftung\",\"kontakt_metadaten\":{\"amt\":\"Statistisches Amt  des Kantons Zürich\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"Comma separated text (.csv)\",\"GeoPackage (.gpkg)\",\"ESRI File Geodatabase (.gdb)\"],\"ogd\":true},{\"uuid\":\"6d73814f-c8aa-0c08-55ee-bacff80a4cc4\",\"kurzbeschreibung\":\"Die archäologischen Zonenpläne stellen einen Verdachtsflächen-Kataster dar.\",\"name\":\"Archäologische Zonenpläne\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"Comma separated text (.csv)\",\"ESRI Shapefile (.shp)\",\"ESRI File Geodatabase (.gdb)\",\"DXF (.dxf)\",\"GeoPackage (.gpkg)\"],\"ogd\":true},{\"uuid\":\"0a44672c-fbe5-afd8-6791-a820c1b5af6e\",\"kurzbeschreibung\":\"In den Archivebenen werden die jährlich abgeschlossenen und über das WebGIS BUN dokumentierten Unterhaltsarbeiten in den überkommunalen Naturschutzgebieten des Kanton Zürich gesammelt.\",\"name\":\"Archiv Betreuungs- und Unterhaltsdokumentation für überkommunale Naturschutzgebiete - BUN\",\"kontakt_metadaten\":{\"amt\":\"Amt für Landschaft und Natur\"},\"abgabeformate\":[\"ESRI File Geodatabase (.gdb)\",\"DXF (.dxf)\",\"Comma separated text (.csv)\",\"GeoPackage (.gpkg)\",\"ESRI Shapefile (.shp)\"],\"ogd\":true},{\"uuid\":\"9f96a6b6-46ac-4167-977b-d5b9d24a6fe8\",\"kurzbeschreibung\":\"Auszug Artendaten von Infospecies für das Gebiets des Kantons Zürich sowie den Arteigenschaften.\",\"name\":\"Artendaten und Arteigenschaften (Flora, Fauna, Flechten, Moose, Pilze)\",\"kontakt_metadaten\":{\"amt\":\"Amt für Landschaft und Natur\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"ESRI File Geodatabase (.gdb)\"],\"ogd\":false},{\"uuid\":\"fb90ba9a-6b84-e7e7-83ab-14203198ed95\",\"kurzbeschreibung\":\"In den Jahren 1976 und 1977 wurden die Feuchtgebiete des Kantons pflanzensoziologisch auf der Basis des Übersichtplans 1:5‘000 kartiert. Die dabei erfassten Artendaten sind den einzelnen Flächen angehängt.\",\"name\":\"Arten der Feuchtgebietskartierung (1976 / 1977)\",\"kontakt_metadaten\":{\"amt\":\"Amt für Landschaft und Natur\"},\"abgabeformate\":[\"Comma separated text (.csv)\",\"GeoPackage (.gpkg)\",\"DXF (.dxf)\",\"ESRI Shapefile (.shp)\",\"ESRI File Geodatabase (.gdb)\"],\"ogd\":true},{\"uuid\":\"3d56b1bb-595f-1065-aa41-cf2416a5cd2b\",\"kurzbeschreibung\":\"Thematische Erweiterung zu den Teilobjektperimeter Lichte Wälder (Nr 255) mit Einzelartvorkommen bezogen auf Flächen oder mit Punktkoordinaten verortet.\",\"name\":\"Arten der Lichten Wälder\",\"kontakt_metadaten\":{\"amt\":\"Amt für Landschaft und Natur\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\"],\"ogd\":false},{\"uuid\":\"eedcf96a-a985-5355-1644-4c565e6a3051\",\"kurzbeschreibung\":\"Die kantonalen und regionalen Trockenstandorte des Kantons sind in den bestehenden GIS-Datensätzen „Inventar 80“ (inv80) und in den „Inventarergänzungen“ von 1997 (inverg) erfasst.\",\"name\":\"Arten der Trockenstandorte TWW (1974 / 1976)\",\"kontakt_metadaten\":{\"amt\":\"Amt für Landschaft und Natur\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"Comma separated text (.csv)\",\"DXF (.dxf)\",\"ESRI File Geodatabase (.gdb)\",\"GeoPackage (.gpkg)\"],\"ogd\":true},{\"uuid\":\"84f71c57-ec41-44bb-b49b-41789f9d0100\",\"kurzbeschreibung\":\"MIV-Auslastung der Knoten für die Abendspitze 2018\",\"name\":\"Auslastung Knoten MIV, Abendspitze\",\"kontakt_metadaten\":{\"amt\":\"Amt für Mobilität\"},\"abgabeformate\":[\"ESRI File Geodatabase (.gdb)\",\"ESRI Shapefile (.shp)\"],\"ogd\":false},{\"uuid\":\"37294cf8-bacd-461d-9ae2-df22ee880188\",\"kurzbeschreibung\":\"MIV-Auslastung der Strecken für die Abendspitze 2018\",\"name\":\"Auslastung Strecken MIV, Abendspitze\",\"kontakt_metadaten\":{\"amt\":\"Amt für Mobilität\"},\"abgabeformate\":[\"ESRI File Geodatabase (.gdb)\",\"ESRI Shapefile (.shp)\"],\"ogd\":false},{\"uuid\":\"9c06d160-323a-41ef-a7f0-c963715f88f8\",\"kurzbeschreibung\":\"In diesem Geodatensatz werden alle Punktobjekte für die Ausnahmetransportrouten dokumentiert. Die Routen selber werden im Geodatenelement Grundgeometrie Strassen Kanton Zürich nachgeführt.\",\"name\":\"Ausnahmetransportrouten Punktobjekte\",\"kontakt_metadaten\":{\"amt\":\"Tiefbauamt\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\"],\"ogd\":false},{\"uuid\":\"3f0176ec-f9ff-45cd-9fa3-803e76a19743\",\"kurzbeschreibung\":\"Gewässer aus dem AV Grunddatensatz\",\"name\":\"AV Gewässer\",\"kontakt_metadaten\":{\"amt\":\"Amt für Abfall, Wasser, Energie und Luft\"},\"abgabeformate\":[\"ESRI File Geodatabase (.gdb)\",\"ESRI Shapefile (.shp)\",\"Comma separated text (.csv)\",\"GeoPackage (.gpkg)\",\"DXF (.dxf)\"],\"ogd\":true},{\"uuid\":\"b4dc2096-b936-630e-83f5-0dbf05d698a0\",\"kurzbeschreibung\":\"Probeflächen und Brutrevierkartierung von Vögeln auf ausgewählten Flächen mit Naturschutzmassnahmen und Kontrollfächen ohne Massnahmen\",\"name\":\"Avifaunistisches Monitoring, Probeflächen mit Revierkartierung, 1990\",\"kontakt_metadaten\":{\"amt\":\"Amt für Landschaft und Natur\"},\"abgabeformate\":[\"ESRI File Geodatabase (.gdb)\",\"Comma separated text (.csv)\",\"ESRI Shapefile (.shp)\",\"GeoPackage (.gpkg)\",\"DXF (.dxf)\"],\"ogd\":true},{\"uuid\":\"fb89c857-84d3-73a4-abbc-39415b21f8c9\",\"kurzbeschreibung\":\"Die Informationsebene Bodenbedeckung ist eine generalisierte und kartografisch bearbeitete Darstellung realer Objekte mit flächiger Ausdehnung.\",\"name\":\"AV MOpublic, Bodenbedeckung\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"GeoPackage (.gpkg)\",\"ESRI File Geodatabase (.gdb)\",\"ESRI Shapefile (.shp)\"],\"ogd\":true},{\"uuid\":\"a24635b9-b366-a81f-b191-08ffea184790\",\"kurzbeschreibung\":\"Die Informationsebene Einzelobjekte umfasst Objekte, die Merkmale der Bodenbedeckung enthalten, welche aufgrund ihrer Eigenschaft oder Ausdehnung aber keine oder unwesentliche flächenmässige Bedeutung haben.\",\"name\":\"AV MOpublic, Einzelobjekte\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"GeoPackage (.gpkg)\",\"ESRI Shapefile (.shp)\",\"ESRI File Geodatabase (.gdb)\"],\"ogd\":true},{\"uuid\":\"75fe4385-de51-3588-40e2-be8575166f2a\",\"kurzbeschreibung\":\"Unter einem Fixpunkt versteht man einen dauerhaft mit einem Stein oder einem Bolzen (zum Teil unter Schacht) versicherten Punkt mit bekannten Koordinaten und/oder bekannter Höhe.\",\"name\":\"AV MOpublic, Fixpunkte\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"ESRI File Geodatabase (.gdb)\",\"ESRI Shapefile (.shp)\",\"GeoPackage (.gpkg)\"],\"ogd\":true},{\"uuid\":\"34711a12-8365-db0d-08f8-e227981bbfd9\",\"kurzbeschreibung\":\"Die Gebäudeadresse setzt sich zusammen aus einer Ortschaft mit Postleitzahl, einem Lokalisationsnamen (in der Regel Strassennamen) und einer Hausnummer.\",\"name\":\"AV MOpublic, Gebäudeadressen\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"GeoPackage (.gpkg)\",\"ESRI File Geodatabase (.gdb)\"],\"ogd\":true},{\"uuid\":\"1466f09e-702d-7b38-053c-7b85f8e82549\",\"kurzbeschreibung\":\"Hoheitsgrenzen sind die Grenzen der politischen Gemeinden, der Kantone und des Landes. Sie liegen auf den Grundstücksgrenzen und sind Bestandteil der amtlichen Vermessung. \",\"name\":\"AV MOpublic, Gemeindegrenzen\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"GeoPackage (.gpkg)\",\"ESRI File Geodatabase (.gdb)\"],\"ogd\":true},{\"uuid\":\"f1cb4419-8bab-ed44-ab87-d65b73da882c\",\"kurzbeschreibung\":\"Die Informationsebene Liegenschaften enthält die Grundstücke  gemäss § 655 Abs 2 ZGB: rechtsgültige und projektierte Liegenschaften (Parzellen), selbständige und dauernde Rechte (z.B. Baurecht) und Bergwerke.\",\"name\":\"AV MOpublic, Liegenschaften\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"GeoPackage (.gpkg)\",\"ESRI File Geodatabase (.gdb)\",\"ESRI Shapefile (.shp)\"],\"ogd\":true},{\"uuid\":\"2c461e43-2979-273c-e8a1-03c06fe005a6\",\"kurzbeschreibung\":\"Flur-, Orts- und Geländenamen (= geografische Namen der amtlichen Vermessung) von geografischen Gebieten, Landschaftsteilen, Flurstücken, topografischen Objekten usw.\",\"name\":\"AV MOpublic, Nomenklatur\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"GeoPackage (.gpkg)\",\"ESRI File Geodatabase (.gdb)\"],\"ogd\":true},{\"uuid\":\"203cf918-2d2a-42da-9374-d1301e761615\",\"kurzbeschreibung\":\"In der Informationsebene Rohrleitungen werden Ölleitungen, Gasleitungen sowie weitere Leitungen nach dem eidgenössischen Rohrleitungsgesetz (RLG, SR 746.1) resp. der eidgenössischen Rohrleitungsverordnung (RLV, SR 746.11) erhoben.\",\"name\":\"AV MOpublic, Rohrleitungen\",\"kontakt_metadaten\":{\"amt\":\"Amt für Raumentwicklung\"},\"abgabeformate\":[\"ESRI Shapefile (.shp)\",\"ESRI File Geodatabase (.gdb)\",\"GeoPackage (.gpkg)\"],\"ogd\":true},{\"u